{% doc %}
  @prompt
    Produktschaufenster für conversion und seo erzeugen durch Abrufen der Produktmetafelder
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-showcase__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-product-showcase__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-product-showcase__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-product-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-product-showcase__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-showcase__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-product-showcase__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-showcase__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-product-showcase__title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-showcase__title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-product-showcase__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .ai-product-showcase__meta-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-product-showcase__meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-product-showcase__meta-label-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-product-showcase__meta-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-product-showcase__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-product-showcase__price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
  }

  .ai-product-showcase__compare-price-{{ ai_gen_id }} {
    color: {{ block.settings.meta_color }};
    font-size: {{ block.settings.meta_size }}px;
    text-decoration: line-through;
  }

  .ai-product-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-product-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-showcase__empty-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.meta_color }};
  }

  .ai-product-showcase__empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-product-showcase__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<product-showcase-{{ ai_gen_id }}
  class="ai-product-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 style="color: {{ block.settings.title_color }}; font-size: {{ block.settings.heading_size }}px; margin: 0 0 {{ block.settings.gap }}px 0;">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="ai-product-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.products != blank %}
      {% for product in block.settings.products %}
        <article
          class="ai-product-showcase__item-{{ ai_gen_id }}"
          itemscope
          itemtype="https://schema.org/Product"
        >
          <a
            href="{{ product.url }}"
            class="ai-product-showcase__image-wrapper-{{ ai_gen_id }}"
            aria-label="{{ product.title }}"
          >
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-product-showcase__image-{{ ai_gen_id }}"
                loading="lazy"
                width="800"
                height="800"
                itemprop="image"
              >
            {% else %}
              <div class="ai-product-showcase__image-{{ ai_gen_id }}" style="background-color: #f4f4f4; display: flex; align-items: center; justify-content: center;">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.show_badge and product.available == false %}
              <span class="ai-product-showcase__badge-{{ ai_gen_id }}">
                {{ block.settings.sold_out_text }}
              </span>
            {% elsif block.settings.show_badge and product.compare_at_price > product.price %}
              <span class="ai-product-showcase__badge-{{ ai_gen_id }}">
                {{ block.settings.sale_text }}
              </span>
            {% endif %}
          </a>

          <div class="ai-product-showcase__content-{{ ai_gen_id }}">
            <h3 class="ai-product-showcase__title-{{ ai_gen_id }}" itemprop="name">
              <a
                href="{{ product.url }}"
                class="ai-product-showcase__title-link-{{ ai_gen_id }}"
              >
                {{ product.title }}
              </a>
            </h3>

            {% if block.settings.show_description and product.description != blank %}
              <div class="ai-product-showcase__description-{{ ai_gen_id }}" itemprop="description">
                {{ product.description | strip_html | truncate: 120 }}
              </div>
            {% endif %}

            {% if block.settings.show_metafields %}
              <div class="ai-product-showcase__meta-{{ ai_gen_id }}">
                {% if block.settings.metafield_1 != blank %}
                  {% assign meta_parts_1 = block.settings.metafield_1 | split: '.' %}
                  {% if meta_parts_1.size == 2 %}
                    {% assign meta_value_1 = product.metafields[meta_parts_1[0]][meta_parts_1[1]] %}
                    {% if meta_value_1 != blank %}
                      <div class="ai-product-showcase__meta-item-{{ ai_gen_id }}">
                        <span class="ai-product-showcase__meta-label-{{ ai_gen_id }}">{{ block.settings.metafield_1_label }}:</span>
                        <span class="ai-product-showcase__meta-value-{{ ai_gen_id }}">{{ meta_value_1 }}</span>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endif %}

                {% if block.settings.metafield_2 != blank %}
                  {% assign meta_parts_2 = block.settings.metafield_2 | split: '.' %}
                  {% if meta_parts_2.size == 2 %}
                    {% assign meta_value_2 = product.metafields[meta_parts_2[0]][meta_parts_2[1]] %}
                    {% if meta_value_2 != blank %}
                      <div class="ai-product-showcase__meta-item-{{ ai_gen_id }}">
                        <span class="ai-product-showcase__meta-label-{{ ai_gen_id }}">{{ block.settings.metafield_2_label }}:</span>
                        <span class="ai-product-showcase__meta-value-{{ ai_gen_id }}">{{ meta_value_2 }}</span>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endif %}

                {% if block.settings.metafield_3 != blank %}
                  {% assign meta_parts_3 = block.settings.metafield_3 | split: '.' %}
                  {% if meta_parts_3.size == 2 %}
                    {% assign meta_value_3 = product.metafields[meta_parts_3[0]][meta_parts_3[1]] %}
                    {% if meta_value_3 != blank %}
                      <div class="ai-product-showcase__meta-item-{{ ai_gen_id }}">
                        <span class="ai-product-showcase__meta-label-{{ ai_gen_id }}">{{ block.settings.metafield_3_label }}:</span>
                        <span class="ai-product-showcase__meta-value-{{ ai_gen_id }}">{{ meta_value_3 }}</span>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-product-showcase__price-wrapper-{{ ai_gen_id }}" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
              <span class="ai-product-showcase__price-{{ ai_gen_id }}" itemprop="price" content="{{ product.price | money_without_currency }}">
                {{ product.price | money }}
              </span>
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-showcase__compare-price-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
              <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
              <link itemprop="availability" href="https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
            </div>

            <a
              href="{{ product.url }}"
              class="ai-product-showcase__button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </a>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="ai-product-showcase__empty-{{ ai_gen_id }}">
        <div class="ai-product-showcase__empty-icon-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
        <p>Wählen Sie Produkte aus, um sie hier anzuzeigen</p>
      </div>
    {% endif %}
  </div>
</product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-showcase-{{ ai_gen_id }}', ProductShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Produktschaufenster",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Produkte",
      "limit": 12
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button-Text",
      "default": "Jetzt ansehen"
    },
    {
      "type": "header",
      "content": "Anzeige"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Produktbeschreibung anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Badges anzeigen",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "sale_text",
      "label": "Sale-Badge-Text",
      "default": "Sale"
    },
    {
      "type": "inline_richtext",
      "id": "sold_out_text",
      "label": "Ausverkauft-Badge-Text",
      "default": "Ausverkauft"
    },
    {
      "type": "header",
      "content": "Metafelder"
    },
    {
      "type": "checkbox",
      "id": "show_metafields",
      "label": "Metafelder anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "metafield_1",
      "label": "Metafeld 1 Schlüssel",
      "info": "Format: namespace.key (z.B. custom.material)"
    },
    {
      "type": "text",
      "id": "metafield_1_label",
      "label": "Metafeld 1 Label",
      "default": "Material"
    },
    {
      "type": "text",
      "id": "metafield_2",
      "label": "Metafeld 2 Schlüssel",
      "info": "Format: namespace.key (z.B. custom.volume)"
    },
    {
      "type": "text",
      "id": "metafield_2_label",
      "label": "Metafeld 2 Label",
      "default": "Volumen"
    },
    {
      "type": "text",
      "id": "metafield_3",
      "label": "Metafeld 3 Schlüssel",
      "info": "Format: namespace.key (z.B. custom.ph_value)"
    },
    {
      "type": "text",
      "id": "metafield_3_label",
      "label": "Metafeld 3 Label",
      "default": "pH-Wert"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Spalten Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Spalten Mobil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Bildverhältnis",
      "options": [
        {
          "value": "1/1",
          "label": "Quadratisch (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landschaft (4:3)"
        },
        {
          "value": "3/4",
          "label": "Hochformat (3:4)"
        },
        {
          "value": "16/9",
          "label": "Breit (16:9)"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand zwischen Karten",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Innenabstand",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Karten-Innenabstand",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#fbfaf6"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Karten-Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titelfarbe",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta-Textfarbe",
      "default": "#6b6a63"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Preisfarbe",
      "default": "#394f2d"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge-Hintergrund",
      "default": "#394f2d"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge-Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button-Hintergrund",
      "default": "#394f2d"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button-Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button-Hover-Hintergrund",
      "default": "#2d3d23"
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Überschriftgröße",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Produkttitelgröße",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Textgröße",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta-Textgröße",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Preisgröße",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Stil"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Container-Eckenradius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Karten-Eckenradius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button-Eckenradius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Produktschaufenster"
    }
  ]
}
{% endschema %}
