    "templates/collection.json",
    "sections/main-product.liquid",
    "sections/product-metafield-details.liquid",
    "sections/product-variant-description.liquid",
    "sections/product-recipe.liquid",
    "sections/product-cross-sell.liquid",
    "sections/main-collection.liquid",
    "sections/featured-collection.liquid",
    "snippets/product-card.liquid",
